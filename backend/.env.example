DATABASE_URL=sqlite:///./mini_ats.db




STORAGE_MODE=local  # use none for metadata-only (no raw CV persistence)
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# SMTP for stage automation emails
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@mini-ats.local
EMAIL_SCHEDULER_INTERVAL_SECONDS=60

# Optional: used to sign webhook payloads
WEBHOOK_SIGNING_SECRET=
AUTH_JWT_SECRET=change-me
AUTH_JWT_EXP_HOURS=72
AUTH_COOKIE_NAME=miniats_session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
AUTH_ALLOW_DEV_HEADERS=true
AUTH_BOOTSTRAP_ADMIN_EMAIL=


