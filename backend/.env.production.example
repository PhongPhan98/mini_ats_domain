# Backend production env
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/miniats
CORS_ORIGINS=https://your-frontend.vercel.app
FRONTEND_BASE_URL=https://your-frontend.vercel.app
PUBLIC_BASE_URL=https://your-backend-domain

AUTH_ALLOW_DEV_HEADERS=false
AUTH_JWT_SECRET=CHANGE_ME_STRONG_SECRET
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-domain/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

PARSE_USE_AI=true
PARSE_AI_TIMEOUT_SECONDS=10
LLM_PROVIDER=gemini
GEMINI_API_KEY=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
EMAIL_SCHEDULER_INTERVAL_SECONDS=60

STORAGE_MODE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=candidate-cvs
